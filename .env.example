# Gemini + MCP Studio settings. Copy to .env, or let deploy.sh write the first four (it keeps every other line).
# Resolution order: environment variable > .env > gcloud config > default. Every value is optional.

# --- Project and storage ------------------------------------------------------------------------------
# Empty = the active gcloud config project.
GOOGLE_CLOUD_PROJECT=
# Where models are called first; a model not served there is looked up in FALLBACK_REGION.
GOOGLE_CLOUD_LOCATION=global
FALLBACK_REGION=us-central1
# Defaults to <project>-gemini-mcp-studio (deploy.sh creates it if missing, in BUCKET_LOCATION).
GCS_BUCKET=
BUCKET_LOCATION=US
# Drive folder URL or ID. Empty = all artifacts go to gs://<bucket>/<project-name>/.
DRIVE_FOLDER=
# gcloud account to use (defaults to the active gcloud account).
GCLOUD_ACCOUNT=
# Streamlit port used by deploy.sh.
PORT=8502

# --- Model Resolver (no model IDs anywhere: they are discovered via MCP and verified in your project) ---
# true = Showcase mode (newest verified, previews allowed); false = Production mode (GA only).
# The UI can switch per build; this sets the default.
ALLOW_PREVIEW_MODELS=true
# Re-resolve when the registry is older than this many hours.
MODEL_REFRESH_HOURS=24
# Re-read model features ("what's new") from the model pages after this many days.
FEATURES_MAX_AGE_DAYS=7
# Promotion gate for text tiers: 9-task golden-set score (0-1; 0.75 = 7 of 9) and latency versus the champion.
PROMOTE_MIN_SCORE=0.75
PROMOTE_MAX_LATENCY_RATIO=2.0
# Daily drift check: roll the champion back if its golden-set score drops by more than this (0.12 = 1 task).
DRIFT_TOLERANCE=0.12
# Quality canary for new embedding / image / speech / music / video models before promotion (1 = on, 0 = off).
# The video sample is the slow, costly one (about $1-3, up to 10 min).
MEDIA_CANARY=1
MEDIA_CANARY_VIDEO=1
# After a model upgrade, rebuild the reference use cases (evals/reference_cases.json, no media) and roll the
# upgrade back if a case's score drops by more than REGRESSION_MAX_DROP points or a passing row now fails.
REGRESSION_ON_UPGRADE=true
REGRESSION_MAX_DROP=10
# Runtime watch: over the last ROLLBACK_WINDOW calls (at least ROLLBACK_MIN_SAMPLES), roll back when the
# error rate reaches ROLLBACK_ERROR_RATE or the output quality falls below ROLLBACK_MIN_QUALITY.
ROLLBACK_WINDOW=8
ROLLBACK_MIN_SAMPLES=4
ROLLBACK_ERROR_RATE=0.5
ROLLBACK_MIN_QUALITY=0.6
# A rolled-back or unavailable model is skipped for this many hours.
QUARANTINE_HOURS=24

# --- Build and evaluation -------------------------------------------------------------------------------
# Plan -> code -> judge attempts per build; failed rubric rows are fed back as fixes.
EVAL_MAX_ATTEMPTS=3
# Minimum LLM-judge score (out of 5) for each judged rubric row.
EVAL_MIN_JUDGE_SCORE=4
# End-to-end acceptance tests: 3..ACCEPTANCE_MAX_TESTS tests written from the ask, run on the chosen design,
# scored by type; the "Use case works end to end" row passes at ACCEPTANCE_MIN_PASS with no safety failure.
ACCEPTANCE_TESTS=true
ACCEPTANCE_MIN_PASS=0.8
ACCEPTANCE_MAX_TESTS=6

# --- Demo output --------------------------------------------------------------------------------------------
# Cap on generated media assets per build (each video variant counts; Veo clips are the main cost).
MAX_MEDIA_ASSETS=16
# Gemini-TTS voice used for every spoken asset.
TTS_VOICE=Kore
# A reasoning model watches / listens to every clip (language, script, lip-sync, look) and regenerates a
# failing clip once. Set to false to skip the check.
MEDIA_QA=true
# Clips generated at the same time (raise if your Veo quota allows; each Veo clip takes about a minute).
MEDIA_PARALLEL=6
# Automatic extra rounds: a failed clip is retried after a pause (20 s, then 60 s), and a clip that fails the
# check is regenerated with the findings; the best-scoring clip is kept.
MEDIA_RETRIES=2
